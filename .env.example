# Copy to .env and adjust. All values are optional (defaults shown).
# Number of production lines (Unit IDs 1..N)
SIM_LINES=3
# 1 = real time; e.g. 100 for a fast warm-up
SIM_TIME_SCALE=1
# Scenario for every line, e.g. cooling-failure (see docs/scenarios.md); empty = none
SIM_SCENARIO=
# Lines the collector polls
UNIT_IDS=1,2,3
POLL_INTERVAL=1s
MODBUS_PORT=1502
DB_PORT=5432
DASHBOARD_PORT=8080
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
POSTGRES_DB=machine
LOG_LEVEL=info
